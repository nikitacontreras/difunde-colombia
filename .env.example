# Copia este archivo a .env y ajusta los valores.
# Todas las variables son opcionales; sin .env se usan los defaults.

# Puerto HTTP
PORT=8080

# Clave del panel oculto. /admin y sus assets/APIs responden 404 si el header
# X-Admin-Key falta o no coincide. Usa una clave larga y aleatoria.
ADMIN_KEY=cambia-esta-clave

# Conexión PostgreSQL/PostGIS
DATABASE_URL=postgres://colombia:colombia@localhost:5432/colombia?sslmode=disable

# Resolución H3 (4-11). 8 = ~0.46 km de borde por celda.
H3_RESOLUTION=8

# Límites de peticiones
MAX_BODY_BYTES=65536
MAX_SYNC_ITEMS=100

# Base ASN local (GeoLite2-ASN.csv o start_ip,end_ip,asn,name,isp).
# Opcional: sin base, ASN/ISP quedan null y operator=desconocido.
#ASN_DB=/data/GeoLite2-ASN.csv

# Mappings ASN -> operador verificados.
# Fuente CSV o tabla asn_operator_mapping (server load-mapping).
#ASN_MAPPING_CSV=/data/asn_operator_mapping.csv
ASN_MAPPING_FROM_DB=true

# CORS opcional (preferir same-origin detrás de un proxy).
#ALLOW_ORIGIN=https://tudominio.example

# Proxies confiables cuyas cabeceras X-Forwarded-For / CF-Connecting-IP se usan
# para la IP real. Fuera de estos CIDRs se toma RemoteAddr. Vacío = no confiar en ninguna.
# Detrás de Docker, incluir el rango del bridge (172.16.0.0/12 cubre 172.16-172.31).
#TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# Probes
PROBE_P_TIMEOUT=5s
PROBE_TIMEOUT=8s
PROBE_INITIAL_PROBES=4
PROBE_MIN_SUCCESS_RATIO=0.4
PROBE_1K_THRESHOLD=2s
PROBE_4K_THRESHOLD=3s

# Umbrales de clasificación de estado
STATE_MIN_SAMPLES=3
STATE_HIGH_CONF_SAMPLES=10
STATE_OPERATIVE_MAX_RTT_MS=900
STATE_JITTER_ELEVATED_MS=400
STATE_DEGRADED_MIN_RTT_MS=1500
STATE_DEGRADED_MAX_SUCCESS=0.8
STATE_PROBABLE_AFFECT_MIN_SAMPLES=5

# Rate limits por IP (por minuto)
RATE_P_PER_MIN=240
RATE_PROBE_PER_MIN=240
RATE_OBSERVE_PER_MIN=60
RATE_SYNC_PER_MIN=20
RATE_CELLS_PER_MIN=300
RATE_UPDATE_PER_MIN=60
RATE_REPORT_PER_MIN=20

# Sismos: polling del catálogo del SGC (casi tiempo real)
# SISMO_POLL_INTERVAL: cadencia del poll (default 30s).
# SISMO_WINDOW: ventana hacia atrás de cada consulta (default 6h).
# SISMO_MIN_MAG: magnitud mínima para notificar (0 = todos).
SISMO_POLL_INTERVAL=30s
SISMO_WINDOW=6h
SISMO_MIN_MAG=0

# Notificaciones push (Web Push). VAPID se autogenera y persiste en la BD.
# PUSH_ENABLED=true
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# Timeouts HTTP
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
